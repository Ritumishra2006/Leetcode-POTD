class Solution {
public:
    int maxProduct(int n) {
       vector<int> ans;
        int prod = 1;
        while(n > 0) {
            int dig = n%10;
            ans.push_back(dig);
            n/=10;
        }
        sort(ans.begin(),ans.end());
       int m = ans.size();
        int last = ans[m-1];
        int secLast = ans[m-2];
        prod = last*secLast;
        
        return prod;
    }
};
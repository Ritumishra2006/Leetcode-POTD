class Solution {
public:
    int maximumProduct(vector<int>& nums) {
        sort(nums.begin(),nums.end());
        int n = nums.size();
        int prod1 = 1;
        int prod2 = 1;
        prod1 = nums[n-1]*nums[n-2]*nums[n-3];
        prod2 = nums[0]*nums[1]*nums[n-1];
        retur max(prod1, prod2); 
    }
};
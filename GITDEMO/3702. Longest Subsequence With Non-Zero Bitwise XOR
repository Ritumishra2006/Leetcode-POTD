class Solution {
public:
    int longestSubsequence(vector<int>& nums) {
        int n = nums.size();
        int allZero = true;
        int resultXOR = 0;
        for(int &x : nums) {
                resultXOR = (resultXOR ^ x);
            if(x != 0) {
                allZero = false;
            }
        }
        if(allZero) {
        return 0;
        }
        return (resultXOR==0)? n-1 : n;
            }
};
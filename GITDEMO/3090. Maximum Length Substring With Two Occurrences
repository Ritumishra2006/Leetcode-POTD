class Solution {
public:
    int maximumLengthSubstring(string s) {
        int n = s.size();
        int maxi = 0;
        for (int i = 0; i < n; i++) {
            int freq[26] = {0};
            for (int j = i; j < n; j++) {
                freq[s[j] - 'a']++;

                if (freq[s[j] - 'a'] > 2)
                    break;

                maxi = max(maxi, j - i + 1);
            }
        }

        return maxi;
    }
};
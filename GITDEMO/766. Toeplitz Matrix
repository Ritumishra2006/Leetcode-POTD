class Solution {
public:
    bool isToeplitzMatrix(vector<vector<int>>& mat) {
        int n = mat.size();
        int m = mat[0].size();
        for(int j = 0; j < m; j++) {
            int i = 0, k = j;
            int val = mat[i][k];
            while(i < n && k < m) {
                if(mat[i][k] != val) {
                    return false;
                }
                i++;
                k++;
            }
        }
        for(int i = 1; i < n; i++) {
            int  k = i;
             int j = 0;
            int val = mat[k][j];
            while(k < n && j < m) {
                if(mat[k][j] != val) {
                    return false;
                }
                k++;
                j++;
            }
        }
          return true;
    }
};
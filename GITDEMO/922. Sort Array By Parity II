class Solution {
public:
    static bool comp(pair<int, int> a, pair<int, int> b) {
        return a.second < b.second;
    }
    vector<int> sortArrayByParityII(vector<int>& nums) {
        vector<pair<int, int>> arr;
        int n = nums.size();
        int even = 0;
        int odd = 1;
        for(int x :  nums) {
            if(x%2 == 0) {
                arr.push_back({x, even});
                even+=2;
            }
         else {
            arr.push_back({x, odd});
            odd+=2;
        }
        }
        sort(arr.begin(), arr.end(), comp);
        for (int i = 0; i < n; i++) {
            nums[i] = arr[i].first;
        }
        return nums;
    }
};
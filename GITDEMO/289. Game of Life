class Solution {
public:
    int n;
    int m;
    bool check(int a, int b) {
        if (a >= 0 && a < m && b >= 0 && b < n) {
            return true;
        } else {
            return false;
        }
    }
    void gameOfLife(vector<vector<int>>& board) {

        m = board.size();
        n = board[0].size();
        vector<vector<int>> ans = board;
        int dx[8] = {0, 0, 1, -1, -1, -1, 1, 1};
        int dy[8] = {1, -1, 0, 0, -1, 1, -1, 1};
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                int cnt = 0;
                for (int k = 0; k < 8; k++) {
                    int nx = i + dx[k];
                    int ny = j + dy[k];
                    if (check(nx, ny) && board[nx][ny] == 1) 
                        cnt++;
                    
                }
                        if (board[i][j] == 1) {
                            if (cnt < 2 || cnt > 3) 
                                ans[i][j] = 0;
                            else   
                                 ans[i][j] = 1; 
                                 
                        } else {
                        if (cnt == 3) 
                            ans[i][j] = 1;
                        else
                         ans[i][j] = 0;
                    }
            }
            
        }
        
        board = ans;
    }
};
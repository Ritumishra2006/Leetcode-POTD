class Solution {
public:
    vector<int> findMissingElements(vector<int>& nums) {
        sort(nums.begin(), nums.end());
        vector<int> ans;
        int n = nums.size();
        int max = nums[n - 1], min = nums[0];

        for (int i = min; i <= max; i++) {
            if (!binary_search(nums.begin(), nums.end(), i)) {
                ans.push_back(i);
            }
        }

        return ans;
    }
};